{
  "providers": {
    "custom": {
      "apiKey": "${LLM_API_KEY}",
      "apiBase": "${LLM_API_BASE}"
    }
  },
  "modelPresets": {
    "padrao": {
      "model": "${LLM_MODELO}",
      "provider": "custom"
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "padrao",
      "timezone": "America/Sao_Paulo",
      "timezoneMode": "manual"
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "allowFrom": ["${WHATSAPP_PERMITIDO}"],
      "groupPolicy": "mention"
    }
  },
  "tools": {
    "restrictToWorkspace": true,
    "exec": {
      "enable": false
    },
    "mcpServers": {
      "tempestivo": {
        "type": "streamableHttp",
        "url": "${TEMPESTIVO_MCP_URL}",
        "headers": {
          "Authorization": "Bearer ${TEMPESTIVO_MCP_TOKEN}"
        },
        "toolTimeout": 60,
        "enabledTools": ["*"]
      }
    }
  },
  "gateway": {
    "host": "127.0.0.1",
    "port": 18790,
    "heartbeat": {
      "enabled": true,
      "intervalS": 900
    }
  }
}

# Variáveis do agente (nanobot). Copie para ~/.nanobot/.env na VPS e preencha.
# O config.json lê estas variáveis com ${NOME}; nada de segredo fica no config.

# Servidor MCP da Escriva (precisa ser alcançável pela VPS: domínio público ou Tailscale)
TEMPESTIVO_MCP_URL=https://SEU-APP.exemplo.com/api/mcp
# Gere na Escriva em Configurações > Agente > Gerar token (escopo Escrita)
TEMPESTIVO_MCP_TOKEN=tempestivo_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de linguagem (qualquer endpoint compatível com a API da OpenAI)
LLM_API_KEY=sua-chave-do-provedor
LLM_API_BASE=https://api.seu-provedor.com/v1
LLM_MODELO=nome-do-modelo-no-provedor

# Seu número de WhatsApp, só dígitos com DDI e DDD, sem "+" (ex.: 5511999998888)
WHATSAPP_PERMITIDO=5511999998888

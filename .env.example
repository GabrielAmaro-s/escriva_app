# =============================================================================
# Escriva: variáveis de ambiente (os nomes TEMPESTIVO_* ficam da marca anterior)
# Copie para .env.local (dia a dia, apontando para o Supabase local) e, se for usar a produção,
# para .env.producao (só os scripts db:* com --producao leem). Os dois ficam fora do git.
# Não crie um .env: o Next lê esse arquivo sozinho.
# Sem as variáveis do Supabase o app roda em "modo local" (dados no navegador).
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fuso do servidor (lembretes e datas do agente). MYPLAN_FUSO_HORARIO, o nome antigo, continua aceito.
TEMPESTIVO_FUSO_HORARIO=America/Sao_Paulo


# Supabase: só servidor (NUNCA usar NEXT_PUBLIC_ nestas)
# Chave secreta (sb_secret_...) ou a "service_role" legada. Ignora o RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=SEU-PROJETO
# Pooler em modo transação (app e scripts curtos)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Conexão de sessão (migrações e pg_dump)
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA-DO-BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Agente (servidor MCP da Escriva)
# Gere com: openssl rand -base64 48
MCP_SEGREDO_TOKENS=troque-por-um-segredo-longo-e-aleatorio
MCP_VALIDADE_TOKEN_DIAS=90
MCP_LIMITE_ITENS_POR_PEDIDO=10
AGENTE_ALERTA_SEM_HEARTBEAT_MIN=60
